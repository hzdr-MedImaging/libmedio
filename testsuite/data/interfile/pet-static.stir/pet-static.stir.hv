!INTERFILE  :=
!version of keys := STIR6.0
name of data file := pet-static.stir.v
!GENERAL DATA :=
!GENERAL IMAGE DATA :=
!type of data := PET
imagedata byte order := LITTLEENDIAN
number of radionuclides := 1
!PET STUDY (General) :=
!PET data type := Image
process status := Reconstructed
!number format := float
!number of bytes per pixel := 4
number of dimensions := 3
matrix axis label [1] := x
!matrix size [1] := 33
scaling factor (mm/pixel) [1] := 1.65
matrix axis label [2] := y
!matrix size [2] := 33
scaling factor (mm/pixel) [2] := 1.65
matrix axis label [3] := z
!matrix size [3] := 37
scaling factor (mm/pixel) [3] := 1.646
first pixel offset (mm) [1] := 0
first pixel offset (mm) [2] := 0
first pixel offset (mm) [3] := -59.2559
number of time frames := 1
!END OF INTERFILE :=
