# Configures the build of Rmedio: bundles the libmedio sources if needed,
# finds Qt5 (Core) and zlib and generates src/Makevars from src/Makevars.in.
#
# The following environment variables override the automatic detection:
#   QT_CFLAGS, QT_LIBS      compiler/linker flags for Qt5Core
#   ZLIB_CFLAGS, ZLIB_LIBS  compiler/linker flags for zlib
#   PKG_CONFIG              pkg-config program to use (default: pkg-config)
#   PKG_CONFIG_PATH         search path of pkg-config, e.g. on macOS with
#                           Homebrew: $(brew --prefix qt@5)/lib/pkgconfig
#

MAKEVARS=${RMEDIO_MAKEVARS:-src/Makevars}
PKG_CONFIG=${PKG_CONFIG:-pkg-config}
if [ -n "${RMEDIO_PKG_CONFIG_STATIC}" ]; then
  PKG_CONFIG_ARGS="--static"
fi

if [ -z "${R_HOME}" ]; then
  R_HOME=$(R RHOME)
fi

#--------------------------------------------------------------------------
# libmedio sources: bundled in the source tarball, otherwise taken from the
# surrounding libmedio source tree (installation from a git checkout)
if [ ! -f src/libmedio/files.mk ]; then
  echo "* bundling the libmedio sources (tools/vendor.sh)"
  sh tools/vendor.sh || exit 1
fi

#--------------------------------------------------------------------------
# Qt5 (Core)
if [ -z "${QT_LIBS}" ]; then
  if "${PKG_CONFIG}" --exists Qt5Core 2>/dev/null; then
    QT_CFLAGS=$("${PKG_CONFIG}" --cflags ${PKG_CONFIG_ARGS} Qt5Core)
    QT_LIBS=$("${PKG_CONFIG}" --libs ${PKG_CONFIG_ARGS} Qt5Core)
    echo "* using Qt5Core $("${PKG_CONFIG}" --modversion Qt5Core)"
  else
    cat >&2 <<EOF
ERROR: Qt5 (Core) was not found with '${PKG_CONFIG}'. Install it, e.g.
         Debian/Ubuntu: sudo apt-get install qtbase5-dev pkg-config
         Fedora:        sudo dnf install qt5-qtbase-devel pkgconf-pkg-config
         macOS:         brew install qt@5 pkg-config
                        export PKG_CONFIG_PATH="\$(brew --prefix qt@5)/lib/pkgconfig"
       or set QT_CFLAGS and QT_LIBS.
EOF
    exit 1
  fi
fi

#--------------------------------------------------------------------------
# zlib
if [ -z "${ZLIB_LIBS}" ]; then
  if "${PKG_CONFIG}" --exists zlib 2>/dev/null; then
    ZLIB_CFLAGS=$("${PKG_CONFIG}" --cflags ${PKG_CONFIG_ARGS} zlib)
    ZLIB_LIBS=$("${PKG_CONFIG}" --libs ${PKG_CONFIG_ARGS} zlib)
  else
    ZLIB_LIBS="-lz"
  fi
fi

#--------------------------------------------------------------------------
# check that the Qt and zlib headers can be used with the compiler of R
CXX=$("${R_HOME}/bin/R" CMD config CXX)
CXXFLAGS=$("${R_HOME}/bin/R" CMD config CXXFLAGS)
CXXPICFLAGS=$("${R_HOME}/bin/R" CMD config CXXPICFLAGS)
CPPFLAGS=$("${R_HOME}/bin/R" CMD config CPPFLAGS)
cat > conftest.cpp <<EOF
#include <QString>
#include <zlib.h>
int main() { QString s(zlibVersion()); return s.isEmpty() ? 1 : 0; }
EOF
if ! ${CXX} ${CPPFLAGS} ${QT_CFLAGS} ${ZLIB_CFLAGS} ${CXXFLAGS} ${CXXPICFLAGS} -c conftest.cpp -o conftest.o >conftest.log 2>&1; then
  cat conftest.log >&2
  echo "ERROR: cannot compile with Qt5Core and zlib (QT_CFLAGS='${QT_CFLAGS}' ZLIB_CFLAGS='${ZLIB_CFLAGS}')" >&2
  rm -f conftest.cpp conftest.o conftest.log
  exit 1
fi
rm -f conftest.cpp conftest.o conftest.log

#--------------------------------------------------------------------------
# generate src/Makevars
RMEDIO_SOURCES=""
for f in src/*.cpp; do
  RMEDIO_SOURCES="${RMEDIO_SOURCES} ${f#src/}"
done

{
  echo "# generated by configure from src/Makevars.in, do not edit"
  cat src/libmedio/files.mk
  echo
  sed -e "s|@RMEDIO_SOURCES@|${RMEDIO_SOURCES# }|" \
      -e "s|@QT_CFLAGS@|${QT_CFLAGS}|" \
      -e "s|@QT_LIBS@|${QT_LIBS}|" \
      -e "s|@ZLIB_CFLAGS@|${ZLIB_CFLAGS}|" \
      -e "s|@ZLIB_LIBS@|${ZLIB_LIBS}|" \
      src/Makevars.in
} > "${MAKEVARS}"

echo "* generated ${MAKEVARS}"
exit 0
